# 复制为 wechat-egress.local.env 后填写自己的服务器；不填分享者的服务器。
WECHAT_EGRESS_HOST=""
WECHAT_EGRESS_USER=""
WECHAT_EGRESS_SSH_PORT="22"
WECHAT_EGRESS_LOCAL_PORT="1088"
WECHAT_EXPECTED_EGRESS_IP=""
WECHAT_EGRESS_AUTH_MODE="key"
# SCRIPT_DIR 由入口脚本设置，自动定位当前技能；含空格路径也可用。
WECHAT_PUBLISHER_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
WECHAT_PUBLISHER_PYTHON="$WECHAT_PUBLISHER_HOME/.venv/bin/python"
# Windows 原生可写稿/排版；此 Bash 固定出口流程请在 WSL 中运行。
